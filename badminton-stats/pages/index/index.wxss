/* 首页样式 */
.header {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.new-match-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 40rpx auto;
  padding: 24rpx 40rpx;
  background-color: #007AFF;
  color: #fff;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  width: 400rpx;
}

.btn-icon {
  font-size: 44rpx;
  font-weight: 300;
}

.match-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  margin: 16rpx 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.match-name {
  font-size: 32rpx;
}

.match-arrow {
  font-size: 40rpx;
  color: #bbb;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
